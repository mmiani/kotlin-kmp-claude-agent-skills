{
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Agent(kmp-ticket-planner)",
      "Agent(kmp-ticket-implementer)",
      "Agent(kmp-ticket-validator)",
      "Agent(kmp-ticket-reviewer)",
      "Agent(kmp-ticket-fixer)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git rev-parse*)",
      "Bash(git merge-base*)",
      "Bash(git ls-files*)",
      "Bash(git ls-tree*)",
      "Bash(git remote -v)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list*)",
      "Bash(./gradlew *)",
      "Bash(java -version)",
      "Bash(node --version)",
      "Bash(gh auth status*)",
      "Bash(.claude/hooks/preflight.sh *)",
      "Bash(.claude/hooks/collect-diff.sh *)",
      "Bash(.claude/hooks/change-digest.sh *)",
      "Bash(.claude/hooks/check-finalization-gate.sh *)",
      "Bash(.claude/hooks/validate-orchestration.sh*)",
      "Bash(.claude/hooks/finalize-summary.sh *)"
    ],
    "ask": [
      "Edit(**)",
      "Write(**)",
      "Bash(git fetch*)",
      "Bash(git switch*)",
      "Bash(git branch*)",
      "Bash(git worktree add*)",
      "Bash(git worktree remove*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(gh pr create*)"
    ],
    "deny": [
      "Edit(*.env)",
      "Write(*.env)",
      "Edit(**/.env*)",
      "Write(**/.env*)",
      "Edit(*.keystore)",
      "Write(*.keystore)",
      "Edit(*.jks)",
      "Write(*.jks)",
      "Edit(**/google-services.json)",
      "Write(**/google-services.json)",
      "Edit(**/credentials*)",
      "Write(**/credentials*)",
      "Edit(**/local.properties)",
      "Write(**/local.properties)",
      "Edit(**/signing*)",
      "Write(**/signing*)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git stash*)",
      "Bash(./gradlew clean build*)",
      "Bash(./gradlew *publish*)",
      "Bash(./gradlew *upload*)",
      "Bash(./gradlew *deploy*)",
      "Bash(./gradlew *distribut*)",
      "Bash(./gradlew install*)",
      "Bash(./gradlew wrapper*)",
      "Bash(./gradlew --init-script*)",
      "Bash(./gradlew -I *)",
      "Bash(npm publish*)",
      "Bash(npm run deploy*)",
      "Bash(npm run publish*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-agent-boundaries.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inject-run-invariants.sh"
          },
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inject-run-invariants.sh"
          },
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inject-run-invariants.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  }
}
